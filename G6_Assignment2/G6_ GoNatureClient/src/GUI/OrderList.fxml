<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="GUI.OrderListController"
      spacing="0" alignment="TOP_CENTER"
      style="-fx-background-color: #2d5a27;"
      prefWidth="600" prefHeight="650">

    <!-- HEADER -->
    <VBox alignment="CENTER" spacing="4"
          style="-fx-background-color: #1b3a17; -fx-padding: 20;">
        <Label text="🌿 GoNature"
               style="-fx-font-size: 26; -fx-font-weight: bold; -fx-text-fill: #f5f0e8;"/>
        <Label text="Order Management"
               style="-fx-font-size: 12; -fx-text-fill: #c8e6c9;"/>
    </VBox>

    <!-- FORM SECTION -->
    <VBox spacing="10" alignment="CENTER"
          style="-fx-background-color: #3a6b33; -fx-padding: 20;">
        <Label text="View / Update Order"
               style="-fx-font-size: 15; -fx-font-weight: bold; -fx-text-fill: #f5f0e8;"/>

        <HBox spacing="10" alignment="CENTER">
            <TextField fx:id="orderIdField" promptText="Order Number"
                       style="-fx-background-color: #f5f0e8; -fx-border-color: #6d4c1f;
                              -fx-border-width: 2; -fx-border-radius: 5; -fx-background-radius: 5;
                              -fx-font-size: 13; -fx-padding: 8;"
                       prefWidth="160"/>
            <TextField fx:id="visitDateField" promptText="yyyy-mm-dd"
                       style="-fx-background-color: #f5f0e8; -fx-border-color: #6d4c1f;
                              -fx-border-width: 2; -fx-border-radius: 5; -fx-background-radius: 5;
                              -fx-font-size: 13; -fx-padding: 8;"
                       prefWidth="160"/>
            <TextField fx:id="visitorCountField" promptText="Visitors"
                       style="-fx-background-color: #f5f0e8; -fx-border-color: #6d4c1f;
                              -fx-border-width: 2; -fx-border-radius: 5; -fx-background-radius: 5;
                              -fx-font-size: 13; -fx-padding: 8;"
                       prefWidth="120"/>
        </HBox>

        <HBox spacing="10" alignment="CENTER">
            <Button text="🔍 Get Orders" onAction="#fetchOrders"
                    style="-fx-background-color: #6d4c1f; -fx-text-fill: white;
                           -fx-font-size: 13; -fx-font-weight: bold;
                           -fx-border-radius: 5; -fx-background-radius: 5;
                           -fx-padding: 8 20 8 20; -fx-cursor: hand;"
                    prefWidth="160"/>
            <Button text="✏️ Update Order" onAction="#submitUpdate"
                    style="-fx-background-color: #4a7c3f; -fx-text-fill: white;
                           -fx-font-size: 13; -fx-font-weight: bold;
                           -fx-border-radius: 5; -fx-background-radius: 5;
                           -fx-padding: 8 20 8 20; -fx-cursor: hand;"
                    prefWidth="160"/>
        </HBox>
    </VBox>

    <!-- ORDERS DISPLAY -->
    <VBox spacing="8" alignment="TOP_CENTER"
          style="-fx-padding: 15;" VBox.vgrow="ALWAYS">
        <Label text="Orders"
               style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #f5f0e8;"/>
        <TextArea fx:id="displayArea"
                  editable="false"
                  style="-fx-background-color: #f5f0e8; -fx-border-color: #6d4c1f;
                         -fx-border-width: 2; -fx-border-radius: 5; -fx-background-radius: 5;
                         -fx-font-size: 12; -fx-padding: 8;"
                  VBox.vgrow="ALWAYS"/>
    </VBox>

    <!-- FOOTER -->
    <HBox alignment="CENTER_RIGHT" spacing="10"
          style="-fx-background-color: #1b3a17; -fx-padding: 10 20 10 20;">
        <Button text="← Back" onAction="#goBack"
                style="-fx-background-color: #4a7c3f; -fx-text-fill: white;
                       -fx-font-size: 12; -fx-border-radius: 5; -fx-background-radius: 5;
                       -fx-padding: 6 20 6 20; -fx-cursor: hand;"/>
        <Button text="Exit" onAction="#exit"
                style="-fx-background-color: #6d4c1f; -fx-text-fill: white;
                       -fx-font-size: 12; -fx-border-radius: 5; -fx-background-radius: 5;
                       -fx-padding: 6 20 6 20; -fx-cursor: hand;"/>
    </HBox>

</VBox>