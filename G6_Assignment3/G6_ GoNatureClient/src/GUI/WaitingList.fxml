<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="GUI.WaitingListController"
      alignment="TOP_CENTER"
      spacing="0"
      prefWidth="900"
      prefHeight="600"
      style="-fx-background-color: #1a3a1a;">

    <HBox alignment="CENTER_LEFT"
          style="-fx-background-color: #0f2210; -fx-padding: 18 30 18 30;">
        <Label text="🌿 GoNature"
               style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: #7ec87e;" />
        <Region HBox.hgrow="ALWAYS" />
        <Label text="My Waiting List"
               style="-fx-font-size: 13; -fx-text-fill: #a5c8a5; -fx-font-style: italic;" />
    </HBox>

    <VBox alignment="CENTER" spacing="4" style="-fx-padding: 16 0 10 0;">
        <Label text="Your Waiting List Entries"
               style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #f0f7f0;" />
        <Label text="Select a row to leave the waiting list"
               style="-fx-font-size: 12; -fx-text-fill: #7aab7a;" />
    </VBox>

    <VBox VBox.vgrow="ALWAYS" style="-fx-padding: 0 30 10 30;">
        <TableView fx:id="waitingTable"
                   VBox.vgrow="ALWAYS"
                   maxWidth="Infinity"
                   style="-fx-background-color: #f9fdf9; -fx-background-radius: 10;
                          -fx-border-radius: 10; -fx-border-color: #3a6b3a; -fx-border-width: 1.5;">
            <columns>
                <TableColumn fx:id="idCol"       text="ID"           prefWidth="50"  style="-fx-alignment: CENTER;" />
                <TableColumn fx:id="parkCol"     text="🏞 Park"      prefWidth="200" />
                <TableColumn fx:id="dateCol"     text="📅 Date"      prefWidth="120" style="-fx-alignment: CENTER;" />
                <TableColumn fx:id="timeCol"     text="🕐 Time"      prefWidth="100" style="-fx-alignment: CENTER;" />
                <TableColumn fx:id="visitorsCol" text="👥 Visitors"  prefWidth="80"  style="-fx-alignment: CENTER;" />
                <TableColumn fx:id="positionCol" text="Position"     prefWidth="80"  style="-fx-alignment: CENTER;" />
                <TableColumn fx:id="statusCol"   text="Status"       prefWidth="120" style="-fx-alignment: CENTER;" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
    </VBox>

    <HBox spacing="12" alignment="CENTER_RIGHT" style="-fx-padding: 10 30 20 30;">
        <Button text="🚪 Leave Waiting List"
                onAction="#handleLeave"
                prefWidth="200" prefHeight="38"
                style="-fx-background-color: #c62828; -fx-text-fill: white; -fx-font-weight: bold;
                       -fx-font-size: 13; -fx-background-radius: 8; -fx-cursor: hand;" />
        <Button text="← Back"
                onAction="#handleBack"
                prefWidth="130" prefHeight="38"
                style="-fx-background-color: #37474f; -fx-text-fill: white;
                       -fx-font-size: 13; -fx-background-radius: 8; -fx-cursor: hand;" />
    </HBox>

</VBox>