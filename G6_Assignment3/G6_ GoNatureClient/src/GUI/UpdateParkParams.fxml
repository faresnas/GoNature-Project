<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="GUI.UpdateParkParamsController"
      alignment="TOP_CENTER"
      spacing="0"
      prefWidth="620"
      prefHeight="680"
      style="-fx-background-color: #1a3a1a;">

    <HBox alignment="CENTER_LEFT"
          style="-fx-background-color: #0f2210; -fx-padding: 16 24 16 24;">
        <Label text="🌿 GoNature"
               style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: #7ec87e;" />
        <Region HBox.hgrow="ALWAYS" />
        <Label text="Park Manager"
               style="-fx-font-size: 12; -fx-text-fill: #a5c8a5; -fx-font-style: italic;" />
    </HBox>

    <VBox alignment="CENTER" spacing="4" style="-fx-padding: 16 0 10 0;">
        <Label text="Update Park Parameters"
               style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: #f0f7f0;" />
        <Label text="Requests will be sent for Department Manager approval"
               style="-fx-font-size: 11; -fx-text-fill: #7aab7a;" />
    </VBox>

    <VBox spacing="12" style="-fx-padding: 0 40 0 40;">
        <VBox spacing="4">
            <Label text="Parameter to Update"
                   style="-fx-text-fill: #a5c8a5; -fx-font-size: 12; -fx-font-weight: bold;" />
            <ComboBox fx:id="paramBox"
                      prefWidth="540" prefHeight="36"
                      style="-fx-background-color: #1e4a1e; -fx-background-radius: 7; -fx-border-color: #3a6b3a; -fx-border-radius: 7;" />
        </VBox>

        <VBox spacing="4">
            <Label text="New Value"
                   style="-fx-text-fill: #a5c8a5; -fx-font-size: 12; -fx-font-weight: bold;" />
            <TextField fx:id="newValueField"
                       promptText="Enter new value"
                       prefWidth="540" prefHeight="36"
                       style="-fx-background-color: #1e4a1e; -fx-text-fill: white; -fx-prompt-text-fill: #5a8a5a; -fx-background-radius: 7; -fx-border-color: #3a6b3a; -fx-border-radius: 7; -fx-padding: 8 10;" />
        </VBox>

        <Label fx:id="currentValuesLabel" text=""
               style="-fx-text-fill: #7aab7a; -fx-font-size: 11;"
               wrapText="true" />
    </VBox>

    <HBox spacing="16" alignment="CENTER" style="-fx-padding: 16 0 16 0;">
        <Button text="✔  Submit Request" onAction="#handleSubmit"
                prefWidth="180" prefHeight="38"
                style="-fx-background-color: #2e7d32; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13; -fx-background-radius: 8; -fx-cursor: hand;" />
        <Button text="← Back" onAction="#handleBack"
                prefWidth="120" prefHeight="38"
                style="-fx-background-color: #37474f; -fx-text-fill: white; -fx-font-size: 13; -fx-background-radius: 8; -fx-cursor: hand;" />
    </HBox>

    <VBox VBox.vgrow="ALWAYS" style="-fx-padding: 0 40 20 40;">
        <Label text="My Park Requests"
               style="-fx-text-fill: #a5c8a5; -fx-font-size: 13; -fx-font-weight: bold; -fx-padding: 0 0 8 0;" />
        <TableView fx:id="requestsTable"
                   VBox.vgrow="ALWAYS"
                   style="-fx-background-color: #f9fdf9; -fx-background-radius: 8; -fx-border-color: #3a6b3a; -fx-border-width: 1.5;">
            <columns>
                <TableColumn fx:id="colParam"  text="Parameter" prefWidth="150" />
                <TableColumn fx:id="colValue"  text="New Value" prefWidth="100" style="-fx-alignment: CENTER;" />
                <TableColumn fx:id="colStatus" text="Status"    prefWidth="110" style="-fx-alignment: CENTER;" />
                <TableColumn fx:id="colDate"   text="Submitted" prefWidth="170" style="-fx-alignment: CENTER;" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
    </VBox>
</VBox>