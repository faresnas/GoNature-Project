<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="GUI.MyReservationsController"
      alignment="TOP_CENTER"
      spacing="0"
      prefWidth="950"
      prefHeight="680"
      style="-fx-background-color: #1a3a1a;">

    <!-- HEADER -->
    <HBox alignment="CENTER_LEFT"
          style="-fx-background-color: #0f2210; -fx-padding: 18 30 18 30;">
        <Label text="🌿 GoNature"
               style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: #7ec87e;" />
        <Region HBox.hgrow="ALWAYS" />
        <Label text="My Reservations"
               style="-fx-font-size: 13; -fx-text-fill: #a5c8a5; -fx-font-style: italic;" />
    </HBox>

    <!-- TITLE -->
    <VBox alignment="CENTER" spacing="4" style="-fx-padding: 20 0 12 0;">
        <Label text="Your Upcoming Visits"
               style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #f0f7f0;" />
        <Label text="Select a row to edit or delete a reservation"
               style="-fx-font-size: 12; -fx-text-fill: #7aab7a;" />
    </VBox>

    <!-- TABLE -->
    <VBox style="-fx-padding: 0 30 0 30;">
        <TableView fx:id="reservationsTable"
                   prefHeight="280"
                   maxWidth="890"
                   style="-fx-background-color: #f9fdf9; -fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #3a6b3a; -fx-border-width: 1.5;">
            <columns>
                <TableColumn fx:id="idCol" text="ID" prefWidth="45" style="-fx-alignment: CENTER;" />
                <TableColumn fx:id="parkCol" text="🏞 Park" prefWidth="180" />
                <TableColumn fx:id="dateCol" text="📅 Visit Date" prefWidth="110" style="-fx-alignment: CENTER;" />
                <TableColumn fx:id="timeCol" text="🕐 Entry Time" prefWidth="100" style="-fx-alignment: CENTER;" />
                <TableColumn fx:id="visitorsCol" text="👥 Visitors" prefWidth="75" style="-fx-alignment: CENTER;" />
                <TableColumn fx:id="typeCol" text="Type" prefWidth="90" style="-fx-alignment: CENTER;" />
                <TableColumn fx:id="statusCol" text="Status" prefWidth="100" style="-fx-alignment: CENTER;" />
                <TableColumn fx:id="codeCol" text="🔑 Confirmation" prefWidth="120" style="-fx-alignment: CENTER;" />
            </columns>
        </TableView>
    </VBox>

    <!-- EDIT PANEL -->
    <VBox spacing="10"
          style="-fx-background-color: #0f2210; -fx-padding: 20 30 20 30;">
        <VBox.margin>
            <Insets top="18" left="30" right="30" bottom="0" />
        </VBox.margin>

        <Label text="✏  Edit Selected Reservation"
               style="-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: #7ec87e;" />

        <HBox spacing="20" alignment="CENTER_LEFT">

            <VBox spacing="5">
                <Label text="Visit Date" style="-fx-text-fill: #a5c8a5; -fx-font-size: 11;" />
                <DatePicker fx:id="datePicker"
                            prefWidth="150"
                            style="-fx-background-color: #1e4a1e; -fx-background-radius: 6; -fx-border-color: #3a6b3a; -fx-border-radius: 6;" />
            </VBox>

            <VBox spacing="5">
                <Label text="Entry Time" style="-fx-text-fill: #a5c8a5; -fx-font-size: 11;" />
                <ComboBox fx:id="timeBox"
                          prefWidth="120"
                          style="-fx-background-color: #1e4a1e; -fx-background-radius: 6; -fx-border-color: #3a6b3a; -fx-border-radius: 6;" />
            </VBox>

            <VBox spacing="5">
                <Label text="Visitors" style="-fx-text-fill: #a5c8a5; -fx-font-size: 11;" />
                <Spinner fx:id="visitorsSpinner"
                         prefWidth="100"
                         min="1"
                         max="50"
                         initialValue="1"
                         editable="true"
                         style="-fx-background-color: #1e4a1e; -fx-background-radius: 6; -fx-border-color: #3a6b3a; -fx-border-radius: 6;" />
            </VBox>

            <Region HBox.hgrow="ALWAYS" />

            <HBox spacing="12" alignment="CENTER_RIGHT">
                <Button text="✔  Update"
                        onAction="#handleUpdateReservation"
                        prefWidth="130" prefHeight="36"
                        style="-fx-background-color: #2e7d32; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13; -fx-background-radius: 8; -fx-cursor: hand;" />
                <Button text="🗑  Delete"
                        onAction="#handleDeleteReservation"
                        prefWidth="130" prefHeight="36"
                        style="-fx-background-color: #c62828; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13; -fx-background-radius: 8; -fx-cursor: hand;" />
                <Button text="← Back"
                        onAction="#handleGoBack"
                        prefWidth="130" prefHeight="36"
                        style="-fx-background-color: #37474f; -fx-text-fill: white; -fx-font-size: 13; -fx-background-radius: 8; -fx-cursor: hand;" />
            </HBox>
        </HBox>
    </VBox>

</VBox>