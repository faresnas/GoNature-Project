<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="GUI.MyReservationsController"
      alignment="CENTER"
      spacing="15"
      prefWidth="850"
      prefHeight="600"
      style="-fx-background-color: #2d5a27; -fx-padding: 25;">

    <Label text="🌿 GoNature"
           style="-fx-font-size: 26; -fx-font-weight: bold; -fx-text-fill: #f5f0e8;" />

    <Label text="My Active Reservations"
           style="-fx-font-size: 16; -fx-text-fill: #c8e6c9;" />

    <TableView fx:id="reservationsTable"
               prefWidth="800"
               prefHeight="300"
               style="-fx-background-color: #f5f0e8;">
        <columns>
            <TableColumn fx:id="idCol" text="ID" prefWidth="50" />
            <TableColumn fx:id="parkCol" text="Park" prefWidth="100" />
            <TableColumn fx:id="dateCol" text="Visit Date" prefWidth="100" />
            <TableColumn fx:id="timeCol" text="Entry Time" prefWidth="90" />
            <TableColumn fx:id="visitorsCol" text="Visitors" prefWidth="70" />
            <TableColumn fx:id="typeCol" text="Type" prefWidth="90" />
            <TableColumn fx:id="statusCol" text="Status" prefWidth="90" />
            <TableColumn fx:id="codeCol" text="Confirmation Code" prefWidth="130" />
        </columns>
    </TableView>

    <Label text="Edit Selected Reservation Parameters" style="-fx-text-fill: #c8e6c9; -fx-font-weight: bold;" />
    
    <HBox alignment="CENTER" spacing="15">
        <children>
            <VBox spacing="5" alignment="CENTER_LEFT">
                <Label text="Date (YYYY-MM-DD):" style="-fx-text-fill: white; -fx-font-size: 11;" />
                <TextField fx:id="dateField" promptText="2026-06-15" prefWidth="120" />
            </VBox>
            
            <VBox spacing="5" alignment="CENTER_LEFT">
                <Label text="Time (HH:MM:SS):" style="-fx-text-fill: white; -fx-font-size: 11;" />
                <TextField fx:id="timeField" promptText="12:00:00" prefWidth="100" />
            </VBox>
            
            <VBox spacing="5" alignment="CENTER_LEFT">
                <Label text="Visitors Count:" style="-fx-text-fill: white; -fx-font-size: 11;" />
                <TextField fx:id="visitorsField" promptText="5" prefWidth="80" />
            </VBox>
        </children>
    </HBox>

    <HBox alignment="CENTER" spacing="20">
        <children>
            <Button text="Update Selected"
                    onAction="#handleUpdateReservation"
                    prefWidth="160"
                    style="-fx-background-color: #8d6e63; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13;" />
                    
            <Button text="Back to Dashboard"
                    onAction="#handleGoBack"
                    prefWidth="160"
                    style="-fx-background-color: #1b3a17; -fx-text-fill: white; -fx-font-size: 13;" />
        </children>
        <VBox.margin>
            <Insets top="10.0" />
        </VBox.margin>
    </HBox>

</VBox>