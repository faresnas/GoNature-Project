<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="GUI.RemoveSubscriberController"
      alignment="TOP_CENTER"
      spacing="0"
      prefWidth="900"
      prefHeight="680"
      style="-fx-background-color: #1a3a1a;">

    <!-- HEADER -->
    <HBox alignment="CENTER_LEFT"
          style="-fx-background-color: #0f2210; -fx-padding: 18 30 18 30;">
        <Label text="🌿 GoNature"
               style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: #7ec87e;" />
        <Region HBox.hgrow="ALWAYS" />
        <Label text="Service Rep"
               style="-fx-font-size: 13; -fx-text-fill: #a5c8a5; -fx-font-style: italic;" />
    </HBox>

    <!-- TITLE -->
    <VBox alignment="CENTER" spacing="4" style="-fx-padding: 16 0 10 0;">
        <Label text="Manage Subscribers"
               style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: #f0f7f0;" />
        <Label text="Select a subscriber to edit or remove"
               style="-fx-font-size: 12; -fx-text-fill: #7aab7a;" />
    </VBox>

    <!-- TABLE -->
    <VBox style="-fx-padding: 0 30 0 30;">
        <TableView fx:id="subscribersTable"
                   prefHeight="220"
                   maxWidth="840"
                   style="-fx-background-color: #f9fdf9; -fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #3a6b3a; -fx-border-width: 1.5;">
            <columns>
                <TableColumn fx:id="idCol"            text="ID"          prefWidth="45"  style="-fx-alignment: CENTER;" />
                <TableColumn fx:id="firstNameCol"     text="First Name"  prefWidth="100" />
                <TableColumn fx:id="lastNameCol"      text="Last Name"   prefWidth="100" />
                <TableColumn fx:id="idNumberCol"      text="ID Number"   prefWidth="95"  style="-fx-alignment: CENTER;" />
                <TableColumn fx:id="phoneCol"         text="Phone"       prefWidth="95"  style="-fx-alignment: CENTER;" />
                <TableColumn fx:id="emailCol"         text="Email"       prefWidth="150" />
                <TableColumn fx:id="familySizeCol"    text="Family"      prefWidth="60"  style="-fx-alignment: CENTER;" />
                <TableColumn fx:id="subscriberNumCol" text="Sub Number"  prefWidth="95"  style="-fx-alignment: CENTER;" />
            </columns>
        </TableView>
    </VBox>

    <!-- EDIT PANEL -->
    <VBox spacing="10"
          style="-fx-background-color: #0f2210; -fx-padding: 16 30 16 30;">
        <VBox.margin>
            <Insets top="14" left="30" right="30" bottom="0" />
        </VBox.margin>

        <Label text="✏  Edit Selected Subscriber"
               style="-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: #7ec87e;" />

        <HBox spacing="10" alignment="CENTER_LEFT">
            <VBox spacing="4">
                <Label text="First Name" style="-fx-text-fill: #a5c8a5; -fx-font-size: 11;" />
                <TextField fx:id="editFirstNameField" promptText="First name" prefWidth="110"
                           style="-fx-background-color: #1e4a1e; -fx-text-fill: white; -fx-prompt-text-fill: #5a8a5a; -fx-background-radius: 6; -fx-border-color: #3a6b3a; -fx-border-radius: 6; -fx-padding: 6 8;" />
            </VBox>
            <VBox spacing="4">
                <Label text="Last Name" style="-fx-text-fill: #a5c8a5; -fx-font-size: 11;" />
                <TextField fx:id="editLastNameField" promptText="Last name" prefWidth="110"
                           style="-fx-background-color: #1e4a1e; -fx-text-fill: white; -fx-prompt-text-fill: #5a8a5a; -fx-background-radius: 6; -fx-border-color: #3a6b3a; -fx-border-radius: 6; -fx-padding: 6 8;" />
            </VBox>
            <VBox spacing="4">
                <Label text="Phone" style="-fx-text-fill: #a5c8a5; -fx-font-size: 11;" />
                <TextField fx:id="editPhoneField" promptText="Phone" prefWidth="110"
                           style="-fx-background-color: #1e4a1e; -fx-text-fill: white; -fx-prompt-text-fill: #5a8a5a; -fx-background-radius: 6; -fx-border-color: #3a6b3a; -fx-border-radius: 6; -fx-padding: 6 8;" />
            </VBox>
            <VBox spacing="4">
                <Label text="Email" style="-fx-text-fill: #a5c8a5; -fx-font-size: 11;" />
                <TextField fx:id="editEmailField" promptText="Email" prefWidth="150"
                           style="-fx-background-color: #1e4a1e; -fx-text-fill: white; -fx-prompt-text-fill: #5a8a5a; -fx-background-radius: 6; -fx-border-color: #3a6b3a; -fx-border-radius: 6; -fx-padding: 6 8;" />
            </VBox>
            <VBox spacing="4">
                <Label text="Family Size" style="-fx-text-fill: #a5c8a5; -fx-font-size: 11;" />
                <Spinner fx:id="editFamilySizeSpinner" prefWidth="80" min="1" max="15"
                         initialValue="1" editable="true"
                         style="-fx-background-color: #1e4a1e; -fx-background-radius: 6; -fx-border-color: #3a6b3a; -fx-border-radius: 6;" />
            </VBox>
        </HBox>

        <HBox spacing="12" alignment="CENTER_LEFT" style="-fx-padding: 6 0 0 0;">
            <Button text="✔  Save Changes"
                    onAction="#handleEdit"
                    prefWidth="150" prefHeight="34"
                    style="-fx-background-color: #2e7d32; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 12; -fx-background-radius: 8; -fx-cursor: hand;" />
            <Button text="🗑  Remove Selected"
                    onAction="#handleRemove"
                    prefWidth="150" prefHeight="34"
                    style="-fx-background-color: #c62828; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 12; -fx-background-radius: 8; -fx-cursor: hand;" />
            <Region HBox.hgrow="ALWAYS" />
            <Button text="← Back"
                    onAction="#handleBack"
                    prefWidth="120" prefHeight="34"
                    style="-fx-background-color: #37474f; -fx-text-fill: white; -fx-font-size: 12; -fx-background-radius: 8; -fx-cursor: hand;" />
        </HBox>
    </VBox>

</VBox>