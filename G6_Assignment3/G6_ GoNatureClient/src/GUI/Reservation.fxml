<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="GUI.ReservationController"
      alignment="TOP_CENTER"
      spacing="0"
      prefWidth="520"
      prefHeight="660"
      style="-fx-background-color: #1a3a1a;">

    <HBox alignment="CENTER_LEFT"
          style="-fx-background-color: #0f2210; -fx-padding: 16 24 16 24;">
        <Label text="🌿 GoNature"
               style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: #7ec87e;" />
        <Region HBox.hgrow="ALWAYS" />
        <Label text="New Reservation"
               style="-fx-font-size: 12; -fx-text-fill: #a5c8a5; -fx-font-style: italic;" />
    </HBox>

    <VBox alignment="CENTER" spacing="4" style="-fx-padding: 20 0 14 0;">
        <Label text="Book Your Visit"
               style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: #f0f7f0;" />
        <Label text="Fill in the details below to reserve your spot"
               style="-fx-font-size: 11; -fx-text-fill: #7aab7a;" />
    </VBox>

    <VBox spacing="12" style="-fx-padding: 0 40 0 40;">

        <VBox spacing="5">
            <Label text="Park" style="-fx-text-fill: #a5c8a5; -fx-font-size: 12; -fx-font-weight: bold;" />
            <ComboBox fx:id="parkBox"
                      prefWidth="440" prefHeight="36"
                      style="-fx-background-color: #1e4a1e; -fx-text-fill: white; -fx-background-radius: 7; -fx-border-color: #3a6b3a; -fx-border-radius: 7;" />
        </VBox>

        <VBox spacing="5">
            <Label text="Visit Date" style="-fx-text-fill: #a5c8a5; -fx-font-size: 12; -fx-font-weight: bold;" />
            <DatePicker fx:id="datePicker"
                        prefWidth="440" prefHeight="36"
                        style="-fx-background-color: #1e4a1e; -fx-background-radius: 7; -fx-border-color: #3a6b3a; -fx-border-radius: 7;" />
        </VBox>

        <VBox spacing="5">
  		  <Label text="Entry Time" style="-fx-text-fill: #a5c8a5; -fx-font-size: 12; -fx-font-weight: bold;" />
   		 <ComboBox fx:id="timeBox"
    	          prefWidth="440" prefHeight="36" />
			</VBox>

			<VBox spacing="5">
    		<Label fx:id="availabilityLabel"
         		  text=""
         	  prefWidth="440"
           style="-fx-text-fill: #7ec87e; -fx-font-size: 12; -fx-padding: 6 10; -fx-background-color: #0f2210; -fx-background-radius: 6;" />
		</VBox>	

        <VBox spacing="5">
            <Label text="Number of Visitors" style="-fx-text-fill: #a5c8a5; -fx-font-size: 12; -fx-font-weight: bold;" />
            <Spinner fx:id="visitorsSpinner"
                     prefWidth="440"
                     prefHeight="36"
                     editable="true"
                     style="-fx-background-color: #1e4a1e; -fx-background-radius: 7; -fx-border-color: #3a6b3a; -fx-border-radius: 7;" />
        </VBox>

        <VBox spacing="5">
            <Label text="Email" style="-fx-text-fill: #a5c8a5; -fx-font-size: 12; -fx-font-weight: bold;" />
            <TextField fx:id="emailField"
                       promptText="email@example.com"
                       prefWidth="440" prefHeight="36"
                       style="-fx-background-color: #1e4a1e; -fx-text-fill: white; -fx-prompt-text-fill: #5a8a5a; -fx-background-radius: 7; -fx-border-color: #3a6b3a; -fx-border-radius: 7; -fx-padding: 0 10;" />
        </VBox>

        <VBox fx:id="prepaidBox" spacing="5" visible="false" managed="false">
            <Label text="Payment Option" style="-fx-text-fill: #a5c8a5; -fx-font-size: 12; -fx-font-weight: bold;" />
            <javafx.scene.control.CheckBox fx:id="prepaidCheck"
                 text="Pay in advance (extra 12% discount — guide excluded from count)"
                 style="-fx-text-fill: #f0f7f0; -fx-font-size: 12;"
                 prefWidth="440"/>
        </VBox>

    </VBox>

    <HBox spacing="16" alignment="CENTER" style="-fx-padding: 24 0 0 0;">
        <Button text="✔  Confirm Booking"
                onAction="#submitReservation"
                prefWidth="200" prefHeight="38"
                style="-fx-background-color: #2e7d32; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13; -fx-background-radius: 8; -fx-cursor: hand;" />
        <Button text="← Back"
                onAction="#goBack"
                prefWidth="120" prefHeight="38"
                style="-fx-background-color: #37474f; -fx-text-fill: white; -fx-font-size: 13; -fx-background-radius: 8; -fx-cursor: hand;" />
    </HBox>

</VBox>