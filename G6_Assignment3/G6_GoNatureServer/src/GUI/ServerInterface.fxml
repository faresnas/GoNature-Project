<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="GUI.ServerInterface"
      spacing="15" alignment="TOP_CENTER"
      style="-fx-background-color: #2d5a27; -fx-padding: 30;"
      prefWidth="320" prefHeight="280">

    <Label text="🌿 GoNature Server"
           style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: #f5f0e8;"/>

    <Label text="Enter Server Port"
           style="-fx-font-size: 13; -fx-text-fill: #c8e6c9;"/>

    <TextField fx:id="portxt" promptText="e.g. 5555"
               style="-fx-background-color: #f5f0e8; -fx-border-color: #6d4c1f;
                      -fx-border-width: 2; -fx-border-radius: 5; -fx-background-radius: 5;
                      -fx-font-size: 14; -fx-padding: 8;"
               maxWidth="200"/>

    <Label fx:id="errorLabel" text=""
           style="-fx-text-fill: #ffcdd2; -fx-font-size: 12;"/>

    <HBox spacing="10" alignment="CENTER">
        <Button fx:id="btnDone" text="Connect" onAction="#done"
                style="-fx-background-color: #6d4c1f; -fx-text-fill: white;
                       -fx-font-size: 14; -fx-font-weight: bold;
                       -fx-border-radius: 5; -fx-background-radius: 5;
                       -fx-padding: 8 30 8 30; -fx-cursor: hand;"/>

        <Button fx:id="btnExit" text="Exit" onAction="#exit"
                style="-fx-background-color: #1b3a17; -fx-text-fill: #c8e6c9;
                       -fx-font-size: 13; -fx-border-radius: 5; -fx-background-radius: 5;
                       -fx-padding: 8 30 8 30; -fx-cursor: hand;"/>
    </HBox>

   

</VBox>