<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="GUI.ServerMainController"
      spacing="12"
      style="-fx-background-color: #1a2e1a; -fx-padding: 20;">

    <Label text="GoNature Server"
           style="-fx-text-fill: #a8d5a2; -fx-font-size: 22px; -fx-font-weight: bold;"/>

    <Label fx:id="statusLabel" text="● STARTING..."
           style="-fx-text-fill: #f0c040; -fx-font-size: 14px; -fx-font-weight: bold;"/>

    <Separator style="-fx-background-color: #3a5a3a;"/>

    <HBox spacing="16">

        <!-- Left: Server Log -->
        <VBox spacing="6" HBox.hgrow="ALWAYS">
            <Label text="Server Log"
                   style="-fx-text-fill: #a8d5a2; -fx-font-size: 13px;"/>
            <TextArea fx:id="logArea"
                      editable="false"
                      wrapText="true"
                      prefHeight="400"
                      prefWidth="380"
                      style="-fx-control-inner-background: #0d1a0d;
                             -fx-text-fill: #c8f0c8;
                             -fx-font-family: 'Courier New';
                             -fx-font-size: 12px;
                             -fx-border-color: #3a5a3a;
                             -fx-border-radius: 4;"/>
        </VBox>

        <!-- Right: Connected Clients -->
        <VBox spacing="6" prefWidth="220">
            <Label text="Connected Clients"
                   style="-fx-text-fill: #a8d5a2; -fx-font-size: 13px;"/>
            <Label fx:id="clientCountLabel" text="0 connected"
                   style="-fx-text-fill: #f0c040; -fx-font-size: 11px;"/>
            <ListView fx:id="clientListView"
                      prefHeight="400"
                      prefWidth="220"
                      style="-fx-control-inner-background: #0d1a0d;
                             -fx-background-color: #0d1a0d;
                             -fx-border-color: #3a5a3a;
                             -fx-border-radius: 4;"/>
        </VBox>

    </HBox>

    <HBox spacing="10">
        <Button text="Clear Log" onAction="#clearLog"
                style="-fx-background-color: #3a5a3a; -fx-text-fill: #a8d5a2;
                       -fx-background-radius: 6; -fx-padding: 4 14;"/>
        <Button text="Stop Server" onAction="#stopServer"
                style="-fx-background-color: #7a2a2a; -fx-text-fill: #f5c6c6;
                       -fx-background-radius: 6; -fx-padding: 4 14;"/>
    </HBox>

</VBox>